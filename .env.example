# Copy to .env and fill in. Never commit the real file.

SKILLMATCH_DATABASE_URL=postgresql+psycopg://daya@127.0.0.1:5433/skillmatch
SKILLMATCH_SECRET=change-me-to-a-long-random-string

# Where uploaded avatars are written (outside the SPA build output).
SKILLMATCH_UPLOAD_DIR=var/avatars

# OAuth callbacks. The backend must be reachable at PUBLIC_BASE_URL and the
# browser returns to FRONTEND_BASE_URL after login.
SKILLMATCH_PUBLIC_BASE_URL=http://127.0.0.1:8766
SKILLMATCH_FRONTEND_BASE_URL=http://127.0.0.1:5173

# GitHub: create an OAuth App at https://github.com/settings/developers
# Callback URL: ${SKILLMATCH_PUBLIC_BASE_URL}/api/auth/oauth/github/callback
SKILLMATCH_GITHUB_CLIENT_ID=
SKILLMATCH_GITHUB_CLIENT_SECRET=

# Google: create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${SKILLMATCH_PUBLIC_BASE_URL}/api/auth/oauth/google/callback
SKILLMATCH_GOOGLE_CLIENT_ID=
SKILLMATCH_GOOGLE_CLIENT_SECRET=
